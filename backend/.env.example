# ExamVault Backend Configuration

# Server
PORT=5000
NODE_ENV=development

# Blockchain Smart Contract Config (Sepolia Testnet)
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CONTRACT_ADDRESS=0xBf5dBf0480F43f96f64F5B3dBC9335EA48c30326

# Demo / Simulation toggles
# When set to true, checkReleaseTime() will return true for all papers to easily demo key release
SIMULATE_RELEASE_PASSED=false

# Paths
UPLOAD_DIR=uploads
AUDIT_LOG_FILE=audit.json
PAPER_STORE_FILE=papers.json
