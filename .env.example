# ExamVault Backend Configuration

# Server
PORT=5000
NODE_ENV=development

# Blockchain Smart Contract Config (ready for ethers.js integration)
RPC_URL=https://rpc.sepolia.org
CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890

# Demo / Simulation toggles
# When set to true, checkReleaseTime() will return true for all papers to easily demo key release
SIMULATE_RELEASE_PASSED=false

# Paths
UPLOAD_DIR=uploads
AUDIT_LOG_FILE=audit.json
